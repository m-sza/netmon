{
  "manifest_version": 2,
  "name": "Always-On Network Monitor",
  "version": "1.7.0",
  "description": "Records network traffic in the background, all the time, and shows it in a DevTools-style network panel.",
  "browser_specific_settings": {
    "gecko": {
      "id": "always-on-netmon@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "storage",
    "tabs",
    "tabGroups",
    "downloads",
    "clipboardWrite",
    "scripting",
    "management"
  ],
  "background": {
    "scripts": [
      "compat.js",
      "common.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "compat.js",
        "page-timing.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_action": {
    "default_title": "Network Monitor",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
